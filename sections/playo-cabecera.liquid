<span id="top"></span>


<div class="hud"{% if section.settings.xmas_fin != blank %} data-fin="{{ section.settings.xmas_fin | escape }}" data-txt="{{ section.settings.xmas_txt | escape }}"{% endif %}><div class="tk"><div class="tk-track" id="tk">
  <span class="tk-i tk-xm" hidden></span>
  <span class="tk-i">{{ section.settings.t3 }}</span>
  <span class="tk-i">{{ section.settings.t2 }}</span>
  <span class="tk-i">{{ section.settings.t4 }}</span>
</div></div></div>

<header class="site"><span class="prog" id="prog"></span><div class="wrap">
  <a class="logo" href="#top" aria-label="Playo, inicio">{{ section.settings.t5 }}<svg viewBox="0 0 200 200" aria-hidden="true" class="lo"><circle cx="100" cy="100" r="80" fill="#15171c" stroke="#F5B800" stroke-width="30"/><g fill="#3FD0FF"><circle cx="100" cy="52" r="11"/><circle cx="141" cy="76" r="11"/><circle cx="141" cy="124" r="11"/><circle cx="100" cy="148" r="11" fill="#E5262F"/><circle cx="59" cy="124" r="11"/><circle cx="59" cy="76" r="11"/></g><circle cx="100" cy="100" r="17" fill="#2c2f37" stroke="#3FD0FF" stroke-width="4"/></svg></a>
  <nav class="links" aria-label="Secciones"><a href="#asaltos">{{ section.settings.t6 }}</a><a href="#categorias">{{ section.settings.t7 }}</a><a href="#cerca">{{ section.settings.t8 }}</a><a href="#faq">{{ section.settings.t9 }}</a></nav>
  <button class="btn sm" data-order>{{ section.settings.t10 }}</button>
</div></header>

{% schema %}
{
  "name": "Cabecera",
  "tag": "div",
  "class": "playo-sec",
  "settings": [
    {
      "type": "text",
      "id": "xmas_txt",
      "label": "Cuenta atrás: texto (detrás se añade la fecha)",
      "default": "Llega para Navidad si pides antes del"
    },
    {
      "type": "text",
      "id": "xmas_fin",
      "label": "Cuenta atrás: último día (AAAA-MM-DD)",
      "info": "Último día para pedir y recibirlo a tiempo. Al pasar, vuelve a salir el texto de envío. Déjalo vacío para quitar la cuenta atrás.",
      "default": "2026-12-18"
    },
    {
      "type": "text",
      "id": "t1",
      "label": "Envío 24-48 h",
      "default": "Envío 24-48 h"
    },
    {
      "type": "text",
      "id": "t2",
      "label": "Paga con tarjeta o al recibir",
      "default": "Paga con tarjeta o al recibir"
    },
    {
      "type": "text",
      "id": "t3",
      "label": "Envío gratis en 24-48 h desde España",
      "default": "Envío gratis en 24-48 h desde España"
    },
    {
      "type": "text",
      "id": "t4",
      "label": "Regalo: Reto Playo de 30 días en familia",
      "default": "Regalo: Reto Playo de 30 días en familia"
    },
    {
      "type": "text",
      "id": "t5",
      "label": "PLAY",
      "default": "PLAY"
    },
    {
      "type": "text",
      "id": "t6",
      "label": "Cómo funciona",
      "default": "Cómo funciona"
    },
    {
      "type": "text",
      "id": "t7",
      "label": "Para quién",
      "default": "Para quién"
    },
    {
      "type": "text",
      "id": "t8",
      "label": "De cerca",
      "default": "De cerca"
    },
    {
      "type": "text",
      "id": "t9",
      "label": "Preguntas",
      "default": "Preguntas"
    },
    {
      "type": "text",
      "id": "t10",
      "label": "Pedir",
      "default": "Pedir"
    }
  ],
  "presets": [
    {
      "name": "Cabecera"
    }
  ]
}
{% endschema %}
