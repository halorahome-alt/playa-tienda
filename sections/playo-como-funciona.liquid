<section id="asaltos" class="canvas-sec"><div class="wrap">
  <div class="sh"><span class="eb">{{ section.settings.t1 }}</span><h2>{{ section.settings.t2 }}<br><span class="ac">{{ section.settings.t3 }}</span></h2></div>
  <div class="rounds">
    <div class="round rv-in"><div class="rn"><span class="label">{{ section.settings.t4 }}</span><svg class="bell" viewBox="0 0 24 24" fill="none" stroke="#E5262F" stroke-width="1.8"><path d="M6 16V11a6 6 0 0112 0v5l2 2H4z"/><path d="M10 21h4"/></svg></div><div class="vis mnt" aria-hidden="true"><span class="mnt-pad p1"></span><span class="mnt-pad p2"></span><span class="mnt-pad p3"></span><img class="mnt-m" src="{% if section.settings.img1 %}{{ section.settings.img1 | image_url: width: 1600 }}{% else %}{{ 'playo-maquina.webp' | asset_url }}{% endif %}" alt=""><span class="mnt-ok">{{ section.settings.t5 }}</span></div><h3>{{ section.settings.t6 }}</h3><p>{{ section.settings.t7 }}</p></div>
    <div class="round rv-in"><div class="rn"><span class="label">{{ section.settings.t8 }}</span><svg class="bell" viewBox="0 0 24 24" fill="none" stroke="#E5262F" stroke-width="1.8"><path d="M6 16V11a6 6 0 0112 0v5l2 2H4z"/><path d="M10 21h4"/></svg></div><div class="vis vv"><video class="lazyv" src="{{ 'playo-musica.mp4' | asset_url }}" poster="{{ 'playo-musica.jpg' | asset_url }}" muted loop playsinline preload="none" aria-label="Vídeo: conectando el móvil por Bluetooth"></video><span class="real">{{ section.settings.t9 }}</span></div><h3>{{ section.settings.t10 }}</h3><p>{{ section.settings.t11 }}</p></div>
    <div class="round rv-in"><div class="rn"><span class="label">{{ section.settings.t12 }}</span><svg class="bell" viewBox="0 0 24 24" fill="none" stroke="#E5262F" stroke-width="1.8"><path d="M6 16V11a6 6 0 0112 0v5l2 2H4z"/><path d="M10 21h4"/></svg></div><div class="vis vv"><video class="lazyv" src="{{ 'playo-golpe-v2.mp4' | asset_url }}" poster="{{ 'playo-golpe-v2.jpg' | asset_url }}" muted loop playsinline preload="none" aria-label="Vídeo: golpeando la diana encendida"></video><span class="real">{{ section.settings.t13 }}</span></div><h3>{{ section.settings.t14 }}</h3><p>{{ section.settings.t15 }}</p></div>
  </div>
</div></section>

<div class="wrap"><div class="ropes" aria-hidden="true"><i></i><i></i><i></i></div></div>

