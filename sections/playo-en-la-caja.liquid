<section class="canvas-sec"><div class="wrap box-grid">
  <div class="box-photo bod rv-in"><span class="ring" aria-hidden="true"></span><img src="{% if section.settings.img1 %}{{ section.settings.img1 | image_url: width: 1600 }}{% else %}{{ 'playo-bodegon.webp' | asset_url }}{% endif %}" alt="Máquina de boxeo con sus guantes, el manual y el cable USB-C"><span class="tag t1">{{ section.settings.t1 }}</span><span class="tag t2">{{ section.settings.t2 }}</span><span class="tag t3">{{ section.settings.t3 }}</span><span class="tag t4">{{ section.settings.t4 }}</span><span class="stamp">{{ section.settings.t5 }}<br>{{ section.settings.t6 }}</span></div>
  <div>
    <div class="sh"><span class="eb">{{ section.settings.t7 }}</span><h2>{{ section.settings.t8 }}<br><span class="ac">{{ section.settings.t9 }}</span></h2></div>
    <ul class="inbox">
      <li><span class="q">×1</span>{{ section.settings.t10 }}</li>
      <li><span class="q">×2</span>{{ section.settings.t11 }}</li>
      <li><span class="q">×1</span>{{ section.settings.t12 }}</li>
      <li><span class="q">×1</span>{{ section.settings.t13 }}</li>
      <li class="g"><span class="q">★</span>{{ section.settings.t14 }}</li>
    </ul>
  </div>
</div></section>

