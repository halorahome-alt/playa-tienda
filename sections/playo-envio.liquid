<section id="envio" class="night"><div class="wrap">
  <div class="sh"><span class="eb">{{ section.settings.t1 }}</span><h2>{{ section.settings.t2 }}<br><span class="ac">{{ section.settings.t3 }}</span></h2></div>
  <div class="timeline" id="tl">
    <div><span class="d">{{ section.settings.t4 }}</span><p>{{ section.settings.t5 }}</p></div>
    <div><span class="d">{{ section.settings.t6 }}</span><p>{{ section.settings.t7 }}</p></div>
    <div><span class="d">{{ section.settings.t8 }}</span><p>{{ section.settings.t9 }}</p></div>
  </div>
</div></section>

