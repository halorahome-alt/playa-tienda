{%- liquid
  assign playo_product = all_products[section.settings.product_handle]
-%}
<script>
  window.PLAYO_VARIANTS = {
    {%- for v in playo_product.variants -%}"{{ forloop.index }}": {{ v.id }}{% unless forloop.last %},{% endunless %}{%- endfor -%}
  };
</script>


<div class="hud"><div class="wrap">
  <span class="cd"><i></i><span>Envío 24-48 h</span></span>
  <div class="msgs" id="msgs">
    <span class="on">Paga con tarjeta o al recibir</span>
    <span>Envío gratis en 24-48 h desde España</span>
    <span>Regalo: Reto Playo de 30 días en familia</span>
  </div>
</div></div>

<header class="site"><span class="prog" id="prog"></span><div class="wrap">
  <a class="logo" href="#top" aria-label="Playo, inicio">PLAY<svg viewBox="0 0 200 200" aria-hidden="true" class="lo"><circle cx="100" cy="100" r="80" fill="#15171c" stroke="#F5B800" stroke-width="30"/><g fill="#3FD0FF"><circle cx="100" cy="52" r="11"/><circle cx="141" cy="76" r="11"/><circle cx="141" cy="124" r="11"/><circle cx="100" cy="148" r="11" fill="#E5262F"/><circle cx="59" cy="124" r="11"/><circle cx="59" cy="76" r="11"/></g><circle cx="100" cy="100" r="17" fill="#2c2f37" stroke="#3FD0FF" stroke-width="4"/></svg></a>
  <nav class="links" aria-label="Secciones"><a href="#asaltos">Cómo funciona</a><a href="#categorias">Para quién</a><a href="#cerca">De cerca</a><a href="#faq">Preguntas</a></nav>
  <button class="btn sm" data-order>Pedir</button>
</div></header>

<main id="top">
<section class="hero"><div class="wrap hero-grid">
  <div class="stage-col">
    <div class="stage" id="stage">
      <span class="spot" aria-hidden="true"></span>
      <div class="score-plate" aria-live="polite"><span class="b">AZUL</span><b id="heroScore">000</b><span class="r">ROJO</span></div>
      <span class="try" id="tryTxt">Toca la diana encendida</span>
      <div class="machine-wrap" id="machine">
        <img class="machine" src="{{ 'playo-maquina.webp' | asset_url }}" alt="Máquina de boxeo musical con las seis dianas iluminadas">
        <button class="pad" style="left:29.6%;top:19.9%" aria-label="Diana 1"></button>
        <button class="pad" style="left:62.1%;top:18.5%" aria-label="Diana 2"></button>
        <button class="pad" style="left:13.8%;top:49%" aria-label="Diana 3"></button>
        <button class="pad" style="left:79.6%;top:48.5%" aria-label="Diana 4"></button>
        <button class="pad" style="left:29.4%;top:79.6%" aria-label="Diana 5"></button>
        <button class="pad" style="left:62.1%;top:80.1%" aria-label="Diana 6"></button>
      </div>
      <div class="rope-set" aria-hidden="true"><i></i><i></i><i></i></div>
      <span class="post l" aria-hidden="true"></span><span class="post r" aria-hidden="true"></span>
      <img class="photo" id="stagePhoto" alt="" hidden>
      <video class="photo" id="stageVid" src="{{ 'playo-golpe.mp4' | asset_url }}" poster="{{ 'playo-golpe.jpg' | asset_url }}" muted loop playsinline preload="none" hidden aria-label="Vídeo: golpeando la máquina en la pared"></video>
    </div>
    <div class="thumbs" role="group" aria-label="Galería">
      <button aria-pressed="true" data-src=""><img src="{{ 'playo-maquina.webp' | asset_url }}" alt="Vista frontal"></button>
      <button aria-pressed="false" data-video="1" class="vthumb"><img src="{{ 'playo-golpe.jpg' | asset_url }}" alt="Vídeo en la pared"><span class="pl" aria-hidden="true"></span></button>
      <button aria-pressed="false" data-src="{{ 'playo-hd-bodegon.webp' | asset_url }}"><img src="{{ 'playo-hd-bodegon.webp' | asset_url }}" alt="Máquina con guantes, cable y manual"></button>
      <button aria-pressed="false" data-src="{{ 'playo-hd-luces.webp' | asset_url }}"><img src="{{ 'playo-hd-luces.webp' | asset_url }}" alt="Luces LED encendidas de cerca"></button>
      <button aria-pressed="false" data-src="{{ 'playo-hd-marcador.webp' | asset_url }}"><img src="{{ 'playo-hd-marcador.webp' | asset_url }}" alt="Marcador LED contando aciertos"></button>
    </div>
    <div class="ctrl">
      <button type="button" class="chipbtn" id="soundBtn" aria-pressed="false"><span class="eq"><i></i><i></i><i></i><i></i></span><span>Con música</span></button>
      <button type="button" class="chipbtn" data-lv="2" aria-pressed="false">Pluma</button>
      <button type="button" class="chipbtn" data-lv="5" aria-pressed="true">Medio</button>
      <button type="button" class="chipbtn" data-lv="9" aria-pressed="false">Pesado</button>
      <span class="spd">Velocidad <b id="spdOut">5</b>/9</span>
    </div>
  </div>

  <form class="buy" id="buy" onsubmit="return false">
    <div class="poster-top"><span class="corner b">Rincón azul</span><span class="vs">vs</span><span class="corner r">Rincón rojo</span></div>
    <h1>Velada en casa<span class="l2">cada noche</span><small>Máquina de boxeo musical de pared</small></h1>
    <div class="price-row"><span class="price-big" data-total>49,99 €</span><span class="cod">Tarjeta o al recibir</span></div>
    <p class="muted">El regalo para los que no se pierden una velada. Su música, las luces marcan el golpe y a combatir en casa.</p>


    <fieldset>
      <legend>Elige tu pack</legend>
      <label class="opt"><input type="radio" name="pack" value="1" checked data-price="49.99" data-label="1 máquina + guantes"><span class="radio"></span>
        <span><span class="name">1 máquina + guantes</span><br><span class="sub">Envío gratis</span></span>
        <span class="price">49,99 €</span></label>
      <label class="opt"><input type="radio" name="pack" value="2" data-price="84.99" data-label="2 máquinas + guantes"><span class="radio"></span><span class="badge">Padre contra hijo</span>
        <span><span class="name">2 máquinas + guantes<span class="duo"><i></i><i></i></span></span><br><span class="sub">Una por rincón</span></span>
        <span class="price">84,99 €<span class="unit">Ahorras 14,99 €</span></span></label>
    </fieldset>

    <div class="gift">
      <span class="gtag">Gratis con tu pedido</span>
      <svg viewBox="0 0 40 40" aria-hidden="true"><circle cx="20" cy="20" r="18" fill="#F5B800"/><path d="M20 9l3.2 6.6 7.3 1-5.3 5.1 1.3 7.2L20 25.5l-6.5 3.4 1.3-7.2-5.3-5.1 7.3-1z" fill="#0A1430"/></svg>
      <div><b>Reto Playo · 30 días en familia</b><span class="s">Retos por nivel y canciones para cada velocidad.</span></div>
    </div>

    <button class="btn cta" type="button" data-order><span>¡Lo quiero! · <span data-total>49,99 €</span></span><small>3 € menos pagando con tarjeta</small></button>

    <div class="trust">
      <div><svg viewBox="0 0 24 24"><rect x="3" y="6" width="18" height="12" rx="2"/><path d="M3 10h18M7 15h3"/></svg>Tarjeta o al recibir</div>
      <div><svg viewBox="0 0 24 24"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7"/><circle cx="7" cy="17" r="1.6"/><circle cx="17" cy="17" r="1.6"/></svg>Envío gratis 24-48 h</div>
      <div><svg viewBox="0 0 24 24"><path d="M12 3l7 3v6c0 4-3 7-7 9-4-2-7-5-7-9V6z"/><path d="M9 12l2 2 4-4"/></svg>30 días de devolución</div>
      <div><svg viewBox="0 0 24 24"><path d="M21 12a8 8 0 01-11.8 7L4 20l1.1-4.6A8 8 0 1121 12z"/></svg>Atención por WhatsApp</div>
    </div>

    <ol class="ship" aria-label="Cuándo llega">
      <li><b>Hoy</b><span>Haces tu pedido</span></li>
      <li><b>Hoy o mañana</b><span>Sale de España</span></li>
      <li><b id="shipIn">En 24-48 h</b><span>En tu casa</span></li>
    </ol>

    <details class="acc">
      <summary>Medidas y especificaciones<span class="pm">+</span></summary>
      <dl>
        <div><dt>Diámetro</dt><dd>35 cm</dd></div>
        <div><dt>Dianas</dt><dd>6, con luz LED</dd></div>
        <div><dt>Velocidades</dt><dd>9 <span class="pend">(a confirmar)</span></dd></div>
        <div><dt>Música</dt><dd>Bluetooth + altavoz</dd></div>
        <div><dt>Carga</dt><dd>USB-C</dd></div>
        <div><dt>Montaje</dt><dd>Sin taladro</dd></div>
        <div><dt>Edad</dt><dd>6+ con un adulto</dd></div>
      </dl>
    </details>
  </form>
</div></section>

<div class="band" aria-hidden="true"><div class="mq"><div class="mq-track" id="mq"></div></div></div>

<section id="fans" class="night fans"><div class="wrap fans-grid">
  <div class="rv-in">
    <div class="sh" style="margin-bottom:0"><span class="eb">El regalo para fans del boxeo</span>
    <h2>Su propia velada<br><span class="ac">en el salón</span></h2></div>
    <div class="chips3">
      <span><svg viewBox="0 0 24 24"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>Su canción de entrada</span>
      <span><svg viewBox="0 0 24 24"><path d="M3 12h18M12 3v18"/></svg>Rincón azul vs rojo</span>
      <span><svg viewBox="0 0 24 24"><circle cx="12" cy="9" r="6"/><path d="M8 14l-2 7 6-3 6 3-2-7"/></svg>Cinturón en juego</span>
    </div>
    <form class="mk" id="mk" onsubmit="return false" aria-label="Crea su cartel">
      <label>Su nombre<input id="mkA" maxlength="12" value="Hugo" autocomplete="off"></label>
      <label>Su apodo<input id="mkAk" maxlength="16" value="El Rayo" autocomplete="off"></label>
      <label class="full">Su rival<input id="mkB" maxlength="12" value="Papá" autocomplete="off"></label>
      <button class="btn cta" type="button" data-order><span>Regálale su velada</span><small>Tarjeta o pago al recibir</small></button>
    </form>
  </div>
  <div class="fans-r rv-in">
  <div class="poster" id="poster" aria-live="polite">
    <span class="rope" style="top:38%"></span><span class="rope" style="top:46%"></span><span class="rope" style="top:54%"></span>
    <div class="ph">Esta noche · En el salón<div class="ttl">Velada en casa</div></div>
    <div class="mid">
      <div class="f b"><svg class="glove" viewBox="0 0 64 64" aria-hidden="true"><path d="M20 34C16 20 24 8 37 8c13 0 19 10 17 22-1 7-5 11-9 13v4H23v-5c-2-2-3-5-3-8z" fill="#fff" stroke="#0b1020" stroke-width="3" stroke-linejoin="round"/><path d="M21 35c-6-1-9-7-6-12 2-3 7-3 9 1 1 2 1 5 0 7" fill="#fff" stroke="#0b1020" stroke-width="3" stroke-linecap="round"/><path d="M28 25c4-6 13-8 21-4" fill="none" stroke="#0b1020" stroke-width="2.5" stroke-linecap="round" opacity=".5"/><rect x="21" y="45" width="26" height="11" rx="2.5" fill="#F5B800" stroke="#0b1020" stroke-width="3"/><path d="M26 50.5h16" stroke="#0b1020" stroke-width="2"/></svg><span class="nm" id="pA">Hugo</span><span class="ak" id="pAk">«El Rayo»</span></div>
      <span class="pvs">VS</span>
      <div class="f r"><svg class="glove" viewBox="0 0 64 64" aria-hidden="true"><path d="M20 34C16 20 24 8 37 8c13 0 19 10 17 22-1 7-5 11-9 13v4H23v-5c-2-2-3-5-3-8z" fill="#fff" stroke="#0b1020" stroke-width="3" stroke-linejoin="round"/><path d="M21 35c-6-1-9-7-6-12 2-3 7-3 9 1 1 2 1 5 0 7" fill="#fff" stroke="#0b1020" stroke-width="3" stroke-linecap="round"/><path d="M28 25c4-6 13-8 21-4" fill="none" stroke="#0b1020" stroke-width="2.5" stroke-linecap="round" opacity=".5"/><rect x="21" y="45" width="26" height="11" rx="2.5" fill="#F5B800" stroke="#0b1020" stroke-width="3"/><path d="M26 50.5h16" stroke="#0b1020" stroke-width="2"/></svg><span class="nm" id="pB">Papá</span><span class="ak">«El Jefe»</span></div>
    </div>
    <div class="pf"><span class="belt">★ Título del salón ★</span><span class="dt" id="pDt">6 de enero · 21:00</span></div>
    <span class="flash"></span>
  </div>
  <div class="dl-row"><button type="button" class="btn sm ghost" id="dlPoster"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12M7 10l5 5 5-5M4 20h16"/></svg>Descargar cartel</button><span>Formato historia: listo para Instagram, TikTok o WhatsApp</span></div>
    <div class="fight" id="board">
      <div class="top">
        <div class="side b"><span class="sm">Rincón azul</span><span class="nm" id="bA">Hugo</span></div>
        <div class="vsx">VS</div>
        <div class="side r"><span class="sm">Rincón rojo</span><span class="nm" id="bB">Papá</span></div>
      </div>
      <div class="scores">
        <div><span class="pts" id="p1">000</span><div class="bar"><span id="b1"></span></div></div>
        <div><span class="pts" id="p2">000</span><div class="bar r"><span id="b2"></span></div></div>
      </div>
      <div class="foot"><span class="winner" id="winner">Asalto 3</span><span class="example">Partida de ejemplo</span></div>
    </div>
  </div>
</div></section>

<section id="asaltos" class="canvas-sec"><div class="wrap">
  <div class="sh"><span class="eb">Cómo funciona</span><h2>Tres asaltos<br><span class="ac">y a jugar</span></h2></div>
  <div class="rounds">
    <div class="round rv-in"><div class="rn"><span class="label">Asalto 1</span><svg class="bell" viewBox="0 0 24 24" fill="none" stroke="#E5262F" stroke-width="1.8"><path d="M6 16V11a6 6 0 0112 0v5l2 2H4z"/><path d="M10 21h4"/></svg></div><div class="vis mnt" aria-hidden="true"><span class="mnt-pad p1"></span><span class="mnt-pad p2"></span><span class="mnt-pad p3"></span><img class="mnt-m" src="{{ 'playo-maquina.webp' | asset_url }}" alt=""><span class="mnt-ok">✓ Sin taladro</span></div><h3>Pégala a la pared</h3><p>Adhesivo y correa incluidos. Sin agujeros.</p></div>
    <div class="round rv-in"><div class="rn"><span class="label">Asalto 2</span><svg class="bell" viewBox="0 0 24 24" fill="none" stroke="#E5262F" stroke-width="1.8"><path d="M6 16V11a6 6 0 0112 0v5l2 2H4z"/><path d="M10 21h4"/></svg></div><div class="vis vv"><video class="lazyv" src="{{ 'playo-musica.mp4' | asset_url }}" poster="{{ 'playo-musica.jpg' | asset_url }}" muted loop playsinline preload="none" aria-label="Vídeo: conectando el móvil por Bluetooth"></video><span class="real">Vídeo real</span></div><h3>Pon tu música</h3><p>Bluetooth desde el móvil.</p></div>
    <div class="round rv-in"><div class="rn"><span class="label">Asalto 3</span><svg class="bell" viewBox="0 0 24 24" fill="none" stroke="#E5262F" stroke-width="1.8"><path d="M6 16V11a6 6 0 0112 0v5l2 2H4z"/><path d="M10 21h4"/></svg></div><div class="vis vv"><video class="lazyv" src="{{ 'playo-golpe.mp4' | asset_url }}" poster="{{ 'playo-golpe.jpg' | asset_url }}" muted loop playsinline preload="none" aria-label="Vídeo: golpeando la diana encendida"></video><span class="real">Vídeo real</span></div><h3>¡Golpea!</h3><p>Antes de que se apague la luz.</p></div>
  </div>
</div></section>

<div class="wrap"><div class="ropes" aria-hidden="true"><i></i><i></i><i></i></div></div>

<section id="categorias" class="canvas-sec"><div class="wrap">
  <div class="sh"><span class="eb">Para quién</span><h2>Una categoría<br><span class="ac">para cada uno</span></h2><p class="lead">Toca una y mira cómo cambia la velocidad de la máquina.</p></div>
  <div class="rail" id="rail">
    <button type="button" class="card" data-speed="2"><span class="cl">Peso pluma</span><span class="cb"><span class="ic"><svg viewBox="0 0 24 24"><circle cx="12" cy="7" r="3.5"/><path d="M6 21v-4a6 6 0 0112 0v4"/></svg></span><h3>Niños</h3><span class="age">Desde 6 años, con un adulto</span><span class="meter" data-v="2"></span><span class="go">Probar velocidad 2 →</span></span></button>
    <button type="button" class="card" data-speed="6"><span class="cl">Peso medio</span><span class="cb"><span class="ic"><svg viewBox="0 0 24 24"><rect x="7" y="2" width="10" height="20" rx="2"/><path d="M11 18h2"/></svg></span><h3>Adolescentes</h3><span class="age">Adiós al móvil un rato</span><span class="meter" data-v="6"></span><span class="go">Probar velocidad 6 →</span></span></button>
    <button type="button" class="card" data-speed="9"><span class="cl">Peso pesado</span><span class="cb"><span class="ic"><svg viewBox="0 0 24 24"><path d="M13 2L4 14h7l-1 8 9-12h-7z"/></svg></span><h3>Adultos</h3><span class="age">Cardio exprés</span><span class="meter" data-v="9"></span><span class="go">Probar velocidad 9 →</span></span></button>
    <button type="button" class="card" data-speed="1"><span class="cl">Peso leyenda</span><span class="cb"><span class="ic"><svg viewBox="0 0 24 24"><path d="M12 21s-7-4.5-9.5-9A5 5 0 0112 6a5 5 0 019.5 6c-2.5 4.5-9.5 9-9.5 9z"/></svg></span><h3>Abuelos</h3><span class="age">Reflejos y risas</span><span class="meter" data-v="1"></span><span class="go">Probar velocidad 1 →</span></span></button>
  </div>
  <div class="rail-nav"><button type="button" id="railPrev" aria-label="Anterior">←</button><button type="button" id="railNext" aria-label="Siguiente">→</button></div>
</div></section>

<section id="cerca" class="night"><div class="wrap hot-grid">
  <div class="hot-stage rv-in">
    <img src="{{ 'playo-maquina.webp' | asset_url }}" alt="Máquina de boxeo musical vista de frente">
    <button class="hs" style="left:37%;top:12%" data-i="0" aria-label="Marcador y volumen">1</button>
    <button class="hs" style="left:40.8%;top:36.8%" data-i="1" aria-label="Luces LED">2</button>
    <button class="hs" style="left:26.8%;top:28.9%" data-i="2" aria-label="Dianas de PU">3</button>
    <button class="hs" style="left:78.2%;top:28.9%" data-i="3" aria-label="Altavoz">4</button>
  </div>
  <div>
    <div class="sh"><span class="eb">De cerca</span><h2>Lista para<br><span class="ac">aguantar golpes</span></h2></div>
    <div class="hot-list">
      <button type="button" class="hot-item" data-i="0"><img src="{{ 'playo-det0.jpg' | asset_url }}" alt=""><div><h3>Marcador LED</h3><p>Cuenta cada acierto. Volumen táctil.</p></div></button>
      <button type="button" class="hot-item" data-i="1"><img src="{{ 'playo-det1.jpg' | asset_url }}" alt=""><div><h3>Luces al ritmo</h3><p>Siguen el compás de tu canción.</p></div></button>
      <button type="button" class="hot-item" data-i="2"><img src="{{ 'playo-det2.jpg' | asset_url }}" alt=""><div><h3>Dianas de PU</h3><p>Acolchadas para los guantes.</p></div></button>
      <button type="button" class="hot-item" data-i="3"><img src="{{ 'playo-det3.jpg' | asset_url }}" alt=""><div><h3>Altavoz</h3><p>La música sale de la máquina.</p></div></button>
    </div>
  </div>
</div></section>

<section class="canvas-sec"><div class="wrap box-grid">
  <div class="box-photo bod rv-in"><span class="ring" aria-hidden="true"></span><img src="{{ 'playo-bodegon.webp' | asset_url }}" alt="Máquina de boxeo con sus guantes, el manual y el cable USB-C"><span class="tag t1">×1 Máquina</span><span class="tag t2">×2 Guantes</span><span class="tag t3">Manual</span><span class="tag t4">USB-C</span><span class="stamp">Lista para<br>envolver</span></div>
  <div>
    <div class="sh"><span class="eb">En la caja</span><h2>Todo lo<br><span class="ac">que llega</span></h2></div>
    <ul class="inbox">
      <li><span class="q">×1</span>Máquina musical con luces LED</li>
      <li><span class="q">×2</span>Guantes acolchados (un par)</li>
      <li><span class="q">×1</span>Correa adhesiva extra ancha</li>
      <li><span class="q">×1</span>Cable USB-C y manual</li>
      <li class="g"><span class="q">★</span>Reto Playo de 30 días · gratis por WhatsApp</li>
    </ul>
  </div>
</div></section>

<section id="envio" class="night"><div class="wrap">
  <div class="sh"><span class="eb">Envío</span><h2>En tu casa<br><span class="ac">en 24-48 horas</span></h2></div>
  <div class="timeline" id="tl">
    <div><span class="d">Hoy</span><p>Haces tu pedido.</p></div>
    <div><span class="d">24-48 h</span><p>En casa, listo para jugar.</p></div>
    <div><span class="d">Esa noche</span><p>Primera velada en casa.</p></div>
  </div>
</div></section>

<section class="canvas-sec"><div class="wrap">
  <div class="sh"><span class="eb">En vuestros salones</span><h2>Así queda<br><span class="ac">en casa</span></h2></div>
  <div class="flow" id="flow">
    <div class="v9"><span class="corner g tg">Tu vídeo</span><span class="play"></span><span class="st">★★★★★</span><q>Aquí irá tu vídeo golpeando al ritmo</q><span class="w9">Prueba en casa · 15 s</span></div>
    <div class="v9"><span class="corner b tg">Cliente</span><span class="play"></span><span class="st">★★★★★</span><q>Padre contra hijo</q><span class="w9">Llega con los primeros pedidos</span></div>
    <div class="v9"><span class="corner r tg">Cliente</span><span class="play"></span><span class="st">★★★★★</span><q>Abriendo el regalo</q><span class="w9">Llega con los primeros pedidos</span></div>
    <div class="v9"><span class="corner b tg">Cliente</span><span class="play"></span><span class="st">★★★★★</span><q>Los abuelos también</q><span class="w9">Llega con los primeros pedidos</span></div>
    <div class="v9"><span class="corner r tg">Cliente</span><span class="play"></span><span class="st">★★★★★</span><q>Nuevo récord</q><span class="w9">Llega con los primeros pedidos</span></div>
    <div class="flow-nav"><button type="button" id="flowPrev" aria-label="Vídeo anterior">←</button><button type="button" id="flowNext" aria-label="Vídeo siguiente">→</button></div>
  </div>
