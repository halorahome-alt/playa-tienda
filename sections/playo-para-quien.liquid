  <div class="rail" id="rail">
    <button type="button" class="card" data-speed="2"><span class="cl">{{ section.settings.t5 }}</span><span class="cb"><span class="ic"><svg viewBox="0 0 24 24"><circle cx="12" cy="7" r="3.5"/><path d="M6 21v-4a6 6 0 0112 0v4"/></svg></span><h3>{{ section.settings.t6 }}</h3><span class="age">{{ section.settings.t7 }}</span><span class="meter" data-v="2"></span><span class="go">{{ section.settings.t8 }}</span></span></button>
    <button type="button" class="card" data-speed="6"><span class="cl">{{ section.settings.t9 }}</span><span class="cb"><span class="ic"><svg viewBox="0 0 24 24"><rect x="7" y="2" width="10" height="20" rx="2"/><path d="M11 18h2"/></svg></span><h3>{{ section.settings.t10 }}</h3><span class="age">{{ section.settings.t11 }}</span><span class="meter" data-v="6"></span><span class="go">{{ section.settings.t12 }}</span></span></button>
    <button type="button" class="card" data-speed="9"><span class="cl">{{ section.settings.t13 }}</span><span class="cb"><span class="ic"><svg viewBox="0 0 24 24"><path d="M13 2L4 14h7l-1 8 9-12h-7z"/></svg></span><h3>{{ section.settings.t14 }}</h3><span class="age">{{ section.settings.t15 }}</span><span class="meter" data-v="9"></span><span class="go">{{ section.settings.t16 }}</span></span></button>
    <button type="button" class="card" data-speed="1"><span class="cl">{{ section.settings.t17 }}</span><span class="cb"><span class="ic"><svg viewBox="0 0 24 24"><path d="M12 21s-7-4.5-9.5-9A5 5 0 0112 6a5 5 0 019.5 6c-2.5 4.5-9.5 9-9.5 9z"/></svg></span><h3>{{ section.settings.t18 }}</h3><span class="age">{{ section.settings.t19 }}</span><span class="meter" data-v="1"></span><span class="go">{{ section.settings.t20 }}</span></span></button>
  </div>
  <div class="rail-nav"><button type="button" id="railPrev" aria-label="Anterior">←</button><button type="button" id="railNext" aria-label="Siguiente">→</button></div>
</div></section>

