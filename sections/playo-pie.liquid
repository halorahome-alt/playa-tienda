{%- liquid
  if product and product.handle == 'maquina-de-boxeo-musical-de-pared'
    assign playo_product = product
  else
    assign playo_product = all_products['maquina-de-boxeo-musical-de-pared']
  endif
  assign v1 = playo_product.variants[0]
  assign v2 = playo_product.variants[1]
  assign p1 = v1.price | default: 4999
  assign p2 = v2.price | default: 8499
  assign ahorro = p1 | times: 2 | minus: p2
-%}
<footer><div class="ropes" aria-hidden="true"><i></i><i></i><i></i></div><div class="wrap">
  <div class="cols">
    <div><a class="logo" href="#top" style="color:#fff" aria-label="Playo">{{ section.settings.t1 }}<svg viewBox="0 0 200 200" aria-hidden="true" class="lo"><circle cx="100" cy="100" r="80" fill="#15171c" stroke="#F5B800" stroke-width="30"/><g fill="#3FD0FF"><circle cx="100" cy="52" r="11"/><circle cx="141" cy="76" r="11"/><circle cx="141" cy="124" r="11"/><circle cx="100" cy="148" r="11" fill="#E5262F"/><circle cx="59" cy="124" r="11"/><circle cx="59" cy="76" r="11"/></g><circle cx="100" cy="100" r="17" fill="#2c2f37" stroke="#3FD0FF" stroke-width="4"/></svg></a><p style="margin-top:12px;max-width:34ch">{{ section.settings.t2 }}</p><div class="soc">{%- if section.settings.social_instagram != blank -%}<a href="{{ section.settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg></a>{%- endif -%}{%- if section.settings.social_tiktok != blank -%}<a href="{{ section.settings.social_tiktok }}" target="_blank" rel="noopener" aria-label="TikTok"><svg viewBox="0 0 24 24"><path d="M14 3v11.5a3.5 3.5 0 11-3.5-3.5"/><path d="M14 3c.5 2.6 2.3 4.4 5 4.6"/></svg></a>{%- endif -%}{%- if section.settings.social_whatsapp != blank -%}<a href="{{ section.settings.social_whatsapp }}" target="_blank" rel="noopener" aria-label="WhatsApp"><svg viewBox="0 0 24 24"><path d="M21 12a8 8 0 01-11.8 7L4 20l1.1-4.6A8 8 0 1121 12z"/></svg></a>{%- endif -%}</div></div>
    <div><h4>{{ section.settings.t3 }}</h4><ul><li><a href="#asaltos">{{ section.settings.t4 }}</a></li><li><a href="#categorias">{{ section.settings.t5 }}</a></li><li><a href="#envio">{{ section.settings.t6 }}</a></li><li><a href="#faq">{{ section.settings.t7 }}</a></li></ul></div>
    <div><h4>{{ section.settings.t8 }}</h4><ul><li><a href="/policies/legal-notice">{{ section.settings.t9 }}</a></li><li><a href="/policies/privacy-policy">{{ section.settings.t10 }}</a></li><li><a href="/policies/refund-policy">{{ section.settings.t11 }}</a></li><li><a href="/policies/terms-of-service">{{ section.settings.t12 }}</a></li></ul></div>
  </div>
  
</div></footer>

<div class="sticky" id="sticky"><div class="p"><span data-total>{{ p1 | money_without_currency }} €</span><small id="stickyPack">{{ section.settings.t13 }}</small></div><button class="btn sm" data-order>{{ section.settings.t14 }}</button></div>

