{%- liquid
  if product and product.handle == 'maquina-de-boxeo-musical-de-pared'
    assign playo_product = product
  else
    assign playo_product = all_products['maquina-de-boxeo-musical-de-pared']
  endif
  assign v1 = playo_product.variants[0]
  assign v2 = playo_product.variants[1]
  assign p1 = v1.price | default: 4999
  assign p2 = v2.price | default: 8499
  assign ahorro = p1 | times: 2 | minus: p2
  assign p2u = p2 | divided_by: 2
  assign v3 = playo_product.variants[2]
  if v3
    assign p3 = v3.price
    assign ahorro3 = p1 | times: 3 | minus: p3
    assign p3u = p3 | divided_by: 3
  endif
-%}
<script>
  window.PLAYO_VARIANTS = {"1": {{ v1.id | default: 0 }}, "2": {{ v2.id | default: 0 }}{% if v3 %}, "3": {{ v3.id }}{% endif %}};
</script>
<section class="hero"><div class="wrap hero-grid">
  <div class="stage-col">
    <div class="stage" id="stage">
      <span class="spot" aria-hidden="true"></span>
      <div class="score-plate" aria-live="polite"><span class="b">{{ section.settings.t1 }}</span><b id="heroScore">000</b><span class="r">{{ section.settings.t2 }}</span></div>
      <span class="try" id="tryTxt">{{ section.settings.t3 }}</span>
      <div class="machine-wrap" id="machine"><svg class="xm-hat xm-el" viewBox="0 0 120 100" aria-hidden="true"><path d="M14 78 C30 30 62 8 96 22 C104 26 108 40 104 52 C96 44 86 42 78 46 C70 52 66 66 66 80 Z" fill="#D42027"/><path d="M40 44 C56 26 80 20 96 22" stroke="#9C121A" stroke-width="4" fill="none" opacity=".5"/><rect x="6" y="72" width="70" height="18" rx="9" fill="#fff"/><circle cx="104" cy="58" r="11" fill="#fff"/></svg>
        <img class="machine" src="{% if section.settings.img1 %}{{ section.settings.img1 | image_url: width: 1600 }}{% else %}{{ 'playo-maquina.webp' | asset_url }}{% endif %}" alt="Máquina de boxeo musical con las seis dianas iluminadas">
        <button class="pad" style="left:29.6%;top:19.9%" aria-label="Diana 1"></button>
        <button class="pad" style="left:62.1%;top:18.5%" aria-label="Diana 2"></button>
        <button class="pad" style="left:13.8%;top:49%" aria-label="Diana 3"></button>
        <button class="pad" style="left:79.6%;top:48.5%" aria-label="Diana 4"></button>
        <button class="pad" style="left:29.4%;top:79.6%" aria-label="Diana 5"></button>
        <button class="pad" style="left:62.1%;top:80.1%" aria-label="Diana 6"></button>
      </div>
      <div class="rope-set" aria-hidden="true"><i></i><i></i><i></i></div>
      <span class="post l" aria-hidden="true"></span><span class="post r" aria-hidden="true"></span>
      <img class="photo" id="stagePhoto" alt="" hidden>
      <video class="photo" id="stageVid" src="{{ 'playo-galeria.mp4' | asset_url }}" poster="{{ 'playo-galeria.jpg' | asset_url }}" muted loop playsinline preload="none" hidden aria-label="Vídeo: golpeando la máquina en la pared"></video>
    </div>
    <div class="thumbs" role="group" aria-label="Galería">
      <button aria-pressed="true" data-src=""><img src="{% if section.settings.img2 %}{{ section.settings.img2 | image_url: width: 1600 }}{% else %}{{ 'playo-maquina.webp' | asset_url }}{% endif %}" alt="Vista frontal"></button>
      <button aria-pressed="false" data-video="1" class="vthumb"><img src="{% if section.settings.img3 %}{{ section.settings.img3 | image_url: width: 1600 }}{% else %}{{ 'playo-galeria.jpg' | asset_url }}{% endif %}" alt="Vídeo en la pared"><span class="pl" aria-hidden="true"></span></button>
      <button aria-pressed="false" data-src="{{ 'playo-hd-bodegon.webp' | asset_url }}"><img src="{% if section.settings.img4 %}{{ section.settings.img4 | image_url: width: 1600 }}{% else %}{{ 'playo-hd-bodegon.webp' | asset_url }}{% endif %}" alt="Máquina con guantes, cable y manual"></button>
      <button aria-pressed="false" data-src="{{ 'playo-hd-luces-v2.webp' | asset_url }}"><img src="{% if section.settings.img5 %}{{ section.settings.img5 | image_url: width: 1600 }}{% else %}{{ 'playo-hd-luces-v2.webp' | asset_url }}{% endif %}" alt="Luces LED encendidas de cerca"></button>
      <button aria-pressed="false" data-src="{{ 'playo-hd-familia.webp' | asset_url }}"><img src="{% if section.settings.img6 %}{{ section.settings.img6 | image_url: width: 1600 }}{% else %}{{ 'playo-hd-familia.webp' | asset_url }}{% endif %}" alt="Padre e hijo jugando en el salón"></button>
    </div>
    <div class="ctrl">
      <button type="button" class="chipbtn" id="soundBtn" aria-pressed="false"><span class="eq"><i></i><i></i><i></i><i></i></span><span>{{ section.settings.t4 }}</span></button>
      <button type="button" class="chipbtn" data-lv="2" aria-pressed="false">{{ section.settings.t5 }}</button>
      <button type="button" class="chipbtn" data-lv="5" aria-pressed="true">{{ section.settings.t6 }}</button>
      <button type="button" class="chipbtn" data-lv="9" aria-pressed="false">{{ section.settings.t7 }}</button>
      <span class="spd">{{ section.settings.t8 }} <b id="spdOut">5</b>/9</span>
    </div>
  </div>

  <form class="buy" id="buy" onsubmit="return false">
    <div class="poster-top"><span class="corner b">{{ section.settings.t9 }}</span><span class="vs">{{ section.settings.t10 }}</span><span class="corner r">{{ section.settings.t11 }}</span></div>
    <span class="xm-seal xm-el"><svg viewBox="0 0 24 24" fill="#16A36A"><path d="M12 2l4 6h-2.5l3.5 5h-2.5l4 6H5.5l4-6H7l3.5-5H8z"/><rect x="11" y="19" width="2" height="3" fill="#8B5A2B"/><circle cx="12" cy="2.5" r="1.6" fill="#F5B800"/></svg>Edición Navidad</span>
    <h1>{{ section.settings.t12 }}<span class="l2">{{ section.settings.t13 }}</span><small>{{ section.settings.t14 }}</small></h1>
    <div class="price-row"><span class="price-big" data-total>{{ p1 | money_without_currency }} €</span><span class="cod">{{ section.settings.t15 }}</span></div><p class="xm-gift xm-el"><svg viewBox="0 0 24 24" fill="none" stroke="#F5B800" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="8" width="18" height="13" rx="1.5"/><path d="M12 8v13M3 12h18"/><path d="M12 8c-1.5-3.5-5.5-4-5.5-1.5S9.5 8 12 8zM12 8c1.5-3.5 5.5-4 5.5-1.5S14.5 8 12 8z"/></svg><span><b>El regalo de Navidad para toda la familia.</b> Pídelo ahora y recíbelo en 24-48 h, con tiempo para el árbol.</span></p>
    <p class="muted">{{ section.settings.t16 }}</p>


    <fieldset>
      <legend>{{ section.settings.t17 }}</legend>
      <label class="opt"><input type="radio" name="pack" value="1" checked data-price="{{ p1 | divided_by: 100.0 }}" data-label="{{ section.settings.t18 }}: 1 máquina + guantes" data-short="1 máquina"><span class="radio"></span>
        <span><span class="name">{{ section.settings.t18 }}</span><br><span class="sub">{{ section.settings.t19 }}</span></span>
        <span class="price">{{ p1 | money_without_currency }} €</span></label>
      <label class="opt"><input type="radio" name="pack" value="2" data-price="{{ p2 | divided_by: 100.0 }}" data-label="{{ section.settings.t21 }}: 2 máquinas + guantes" data-short="2 máquinas"><span class="radio"></span>{% if section.settings.t20 != blank %}<span class="badge">{{ section.settings.t20 }}</span>{% endif %}
        <span><span class="name">{{ section.settings.t21 }}<span class="duo"><i></i><i></i></span></span><br><span class="sub">{{ section.settings.t22 }}</span></span>
        <span class="price">{{ p2 | money_without_currency }} €<span class="unit">Ahorras {{ ahorro | money_without_currency }} €</span><span class="per">{{ p2u | money_without_currency }} € {{ section.settings.per_txt }}</span></span></label>
      {%- if v3 %}
      <label class="opt"><input type="radio" name="pack" value="3" data-price="{{ p3 | divided_by: 100.0 }}" data-label="{{ section.settings.f_name }}: 3 máquinas + guantes" data-short="3 máquinas"><span class="radio"></span>{% if section.settings.f_badge != blank %}<span class="badge gold">{{ section.settings.f_badge }}</span>{% endif %}
        <span><span class="name">{{ section.settings.f_name }}<span class="duo trio"><i></i><i></i><i></i></span></span><br><span class="sub">{{ section.settings.f_sub }}</span></span>
        <span class="price">{{ p3 | money_without_currency }} €<span class="unit">Ahorras {{ ahorro3 | money_without_currency }} €</span><span class="per">{{ p3u | money_without_currency }} € {{ section.settings.per_txt }}</span></span></label>
      {%- endif %}
    </fieldset>

    <div class="gift">
      <span class="gtag">{{ section.settings.t23 }}</span>
      <svg viewBox="0 0 40 40" aria-hidden="true"><circle cx="20" cy="20" r="18" fill="#F5B800"/><path d="M20 9l3.2 6.6 7.3 1-5.3 5.1 1.3 7.2L20 25.5l-6.5 3.4 1.3-7.2-5.3-5.1 7.3-1z" fill="#0A1430"/></svg>
      <div><b>{{ section.settings.t24 }}</b><span class="s">{{ section.settings.t25 }}</span></div>
    </div>

    <button class="btn cta" type="button" data-order><span>{{ section.settings.t26 }} <span data-total>{{ p1 | money_without_currency }} €</span></span><small>{{ section.settings.t27 }}</small></button>

    <div class="trust">
      <div><svg viewBox="0 0 24 24"><rect x="3" y="6" width="18" height="12" rx="2"/><path d="M3 10h18M7 15h3"/></svg>{{ section.settings.t28 }}</div>
      <div><svg viewBox="0 0 24 24"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7"/><circle cx="7" cy="17" r="1.6"/><circle cx="17" cy="17" r="1.6"/></svg>{{ section.settings.t29 }}</div>
      <div><svg viewBox="0 0 24 24"><path d="M12 3l7 3v6c0 4-3 7-7 9-4-2-7-5-7-9V6z"/><path d="M9 12l2 2 4-4"/></svg>{{ section.settings.t30 }}</div>
      <div><svg viewBox="0 0 24 24"><path d="M21 12a8 8 0 01-11.8 7L4 20l1.1-4.6A8 8 0 1121 12z"/></svg>{{ section.settings.t31 }}</div>
    </div>

    <div class="dudas">
      <details class="acc"><summary>{{ section.settings.d1_t }}<span class="pm">+</span></summary><p>{{ section.settings.d1_x }}</p></details>
      <details class="acc"><summary>{{ section.settings.d2_t }}<span class="pm">+</span></summary><p>{{ section.settings.d2_x }}</p></details>
      <details class="acc"><summary>{{ section.settings.d3_t }}<span class="pm">+</span></summary><p>{{ section.settings.d3_x }}</p></details>
    </div>

    <ol class="ship" aria-label="Cuándo llega">
      <li><b>{{ section.settings.t32 }}</b><span>{{ section.settings.t33 }}</span></li>
      <li><b>{{ section.settings.t34 }}</b><span>{{ section.settings.t35 }}</span></li>
      <li><b id="shipIn">{{ section.settings.t36 }}</b><span>{{ section.settings.t37 }}</span></li>
    </ol>

    <details class="acc">
      <summary>{{ section.settings.t38 }}<span class="pm">+</span></summary>
      <dl>
        <div><dt>{{ section.settings.t39 }}</dt><dd>{{ section.settings.t40 }}</dd></div>
        <div><dt>{{ section.settings.t41 }}</dt><dd>{{ section.settings.t42 }}</dd></div>
        <div><dt>{{ section.settings.t43 }}</dt><dd>9</dd></div>
        <div><dt>{{ section.settings.t44 }}</dt><dd>{{ section.settings.t45 }}</dd></div>
        <div><dt>{{ section.settings.t46 }}</dt><dd>{{ section.settings.t47 }}</dd></div>
        <div><dt>{{ section.settings.t48 }}</dt><dd>{{ section.settings.t49 }}</dd></div>
        <div><dt>{{ section.settings.t50 }}</dt><dd>{{ section.settings.t51 }}</dd></div>
      </dl>
    </details>
  </form>
</div></section>

<div class="band" aria-hidden="true"><div class="mq"><div class="mq-track" id="mq"></div></div></div>

