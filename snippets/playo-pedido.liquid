{%- liquid
  if product and product.handle == 'maquina-de-boxeo-musical-de-pared'
    assign playo_product = product
  else
    assign playo_product = all_products['maquina-de-boxeo-musical-de-pared']
  endif
  assign v1 = playo_product.variants[0]
  assign v2 = playo_product.variants[1]
  assign p1 = v1.price | default: 4999
  assign p2 = v2.price | default: 8499
  assign ahorro = p1 | times: 2 | minus: p2
  assign v3 = playo_product.variants[2]
  if v3
    assign p3 = v3.price
    assign ahorro3 = p1 | times: 3 | minus: p3
  endif
-%}
<dialog id="order" aria-labelledby="orderTitle">
  <form class="dlg" id="orderForm" novalidate>
    <div class="dlg-head"><h3 id="orderTitle">Tu pedido</h3><button class="x" type="button" id="closeDlg" aria-label="Cerrar">×</button></div>
    <div class="step"><span class="n">1</span>Tu pack</div>
    <div class="dpacks">
      <label class="dp"><input type="radio" name="dpack" value="1" checked><img src="{{ 'playo-maquina.webp' | asset_url }}" alt=""><span><b>1 · Pack individual</b><small>1 máquina + guantes</small></span><span class="pr">{{ p1 | money_without_currency }} €</span></label>
      <label class="dp"><input type="radio" name="dpack" value="2"><span class="badge dp-badge">Ideal para regalar</span><span class="duo2"><img src="{{ 'playo-maquina.webp' | asset_url }}" alt=""><img src="{{ 'playo-maquina.webp' | asset_url }}" alt=""></span><span><b>2 · Pack padre e hijo</b><small>Ahorras {{ ahorro | money_without_currency }} €</small></span><span class="pr">{{ p2 | money_without_currency }} €</span></label>
      {%- if v3 %}
      <label class="dp"><input type="radio" name="dpack" value="3"><span class="badge gold dp-badge">Mejor precio</span><span class="duo2"><img src="{{ 'playo-maquina.webp' | asset_url }}" alt=""><img src="{{ 'playo-maquina.webp' | asset_url }}" alt=""><img src="{{ 'playo-maquina.webp' | asset_url }}" alt=""></span><span><b>3 · Pack familia</b><small>Ahorras {{ ahorro3 | money_without_currency }} €</small></span><span class="pr">{{ p3 | money_without_currency }} €</span></label>
      {%- endif %}
    </div>
    <div class="gift2"><svg viewBox="0 0 40 40" aria-hidden="true"><circle cx="20" cy="20" r="18" fill="#F5B800"/><path d="M20 9l3.2 6.6 7.3 1-5.3 5.1 1.3 7.2L20 25.5l-6.5 3.4 1.3-7.2-5.3-5.1 7.3-1z" fill="#0A1430"/></svg><span><b>Reto Playo · 30 días en familia</b><small>De regalo, te llega por WhatsApp</small></span><span class="free">Gratis</span></div>
    <div class="step"><span class="n">2</span>¿Dónde lo enviamos?</div>
    <div class="fields">
      <label class="f full" for="fName">Nombre y apellidos<input id="fName" required autocomplete="name"><span class="err">Escribe tu nombre y apellidos</span></label>
      <label class="f full" for="fPhone"><span>Teléfono <span class="hint">· te mandamos el pedido por WhatsApp</span></span><input id="fPhone" required inputmode="tel" autocomplete="tel" pattern="[0-9 +]{9,15}"><span class="err">Revisa el teléfono: 9 cifras</span></label>
      <label class="f full" for="fAddr">Calle, número, piso y letra<input id="fAddr" required autocomplete="street-address"><span class="err">Falta la dirección</span></label>
      <label class="f" for="fZip">Código postal<input id="fZip" maxlength="5" required inputmode="numeric" pattern="[0-9]{5}" autocomplete="postal-code"><span class="err">5 cifras</span></label>
      <label class="f" for="fCity">Ciudad<input id="fCity" required autocomplete="address-level2"><span class="err">Falta la ciudad</span></label>
      <label class="f full" for="fProv">Provincia<select id="fProv" required><option value="">Elige provincia</option></select><span class="err">Elige tu provincia</span></label>
    </div>
    <input type="radio" name="pay" value="card" checked hidden>
    <dl class="bd">
      <div><dt id="bdLabel">1 máquina + guantes</dt><dd id="bdSub">{{ p1 | money_without_currency }} €</dd></div>
      <div><dt>Envío 24-48 h</dt><dd class="okc">Gratis</dd></div>
      <div><dt>Reto Playo 30 días</dt><dd class="okc">Gratis</dd></div>
      <div class="tt"><dt>Total</dt><dd id="sumTot">{{ p1 | money_without_currency }} €</dd></div>
    </dl>
    <div class="paybar">
    <button class="btn cta" type="submit"><span><span id="payVerb">Pagar</span> · <span id="payTotal">{{ p1 | money_without_currency }} €</span></span><small id="paySub">Tarjeta, Google Pay o al recibir</small></button>
    <p class="cod2" id="payNote">En el siguiente paso eliges cómo pagar: tarjeta o al recibir.</p>
    </div>
    <ul class="tr3"><li><svg viewBox="0 0 24 24"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 018 0v3"/></svg>Pago seguro</li><li><svg viewBox="0 0 24 24"><path d="M3 12a9 9 0 109-9"/><path d="M3 4v5h5"/></svg>14 días de devolución</li><li><svg viewBox="0 0 24 24"><path d="M21 12a8 8 0 01-11.8 7L4 20l1.1-4.6A8 8 0 1121 12z"/></svg>Ayuda por WhatsApp</li></ul>
  </form>
  <div class="dlg done" id="done" hidden>
    <div class="ok"><span class="burst"></span>✓</div><h3>¡Pedido recibido!</h3><p id="orderNo" style="font-size:14px;color:var(--muted)"></p><p style="color:var(--muted)" id="doneMsg">Te mandamos tu pedido y el regalo por WhatsApp en unos minutos.</p>
    <button class="btn sm" type="button" id="closeDone">Cerrar</button>
  </div>
</dialog>
